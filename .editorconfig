root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# Byte-exact od(1) output captures; the trailing spaces are part of the data.
[tests/fixtures/od/*]
trim_trailing_whitespace = false
insert_final_newline = false
